# Puerto donde corre el servidor Express
PORT=5000

# Afecta las cookies del refresh token
NODE_ENV=development

# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# API key (service role) del proyecto de Supabase
SUPABASE_KEY=

# Secreto para firmar el access token (JWT de corta duracion)
JWT_SECRET=

# Secreto para firmar el refresh token
JWT_REFRESH_SECRET=

# API key de Google Generative AI (Gemini), usada para extraer datos de comprobantes
# y detectar bebidas alcoholicas en facturas y descripciones de gasto
GEMINI_API_KEY=

# API key de Brevo (antes Sendinblue), usada para enviar correos transaccionales
BREVO_API_KEY=

# API key de AbstractAPI, usada para validar que un correo exista antes de enviar el codigo de verificacion
ABSTRACT_EMAIL_API_KEY=

# URL del cliente web, usada en el enlace de "Ingresar al sistema" del correo de bienvenida
FRONTEND_URL=https://scv-frontend.vercel.app
