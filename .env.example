# Puerto donde corre el servidor Express
PORT=5000

# Afecta las cookies del refresh token 
NODE_ENV=development

# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# API key (service role o anon) del proyecto de Supabase
SUPABASE_KEY=

# Secreto para firmar el access token (JWT de corta duracion, 15m)
JWT_SECRET=

# Secreto para firmar el refresh token
JWT_REFRESH_SECRET=

# API key de Brevo (antes Sendinblue), usada para enviar correos transaccionales
BREVO_API_KEY=

# API key de AbstractAPI, usada para validar que un correo exista antes de enviar el codigo de verificacion
ABSTRACT_EMAIL_API_KEY=

# API key de Groq, usada para el analisis con IA de facturas (extraccion de datos) y deteccion de alcohol
GROQ_API_KEY=

# API key de OCR.space, usada como respaldo para extraer texto de facturas cuando no se puede leer el QR
OCR_SPACE_API_KEY=

# No son usadas por el cambio a Brevo
#GMAIL_USER=
#GMAIL_PASS=